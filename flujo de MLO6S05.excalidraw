      "isDeleted": false,
      "boundElements": null,
      "updated": 1775416850433,
      "link": null,
      "locked": false,
      "text": "1. Click on search bar\n      Typing \"n\" characters\n        Show a list of \"n\" previewed results\n        If n = 0\n          End interaction\n        Else\n          Click on any Item showed in a list with preview \"n\" results\n          Click on Search Icon\n        Apply filters\n          None\n          Sort by \n            Price Low to High\n            Price High or Low\n          Price range\n            Based on list of results. Get MAX and MIN and split in 5 slots\n              S/. 0 - S/. 20\n              S/. 21 - S/. 30\n              ...\n          Brands\n            Based on list of results group by categories\n              None\n              Nike\n              Adidas\n\n        Click on \"Apply Filters\" button\n          Show a list of \"n\" results\n            If n = 0\n              End interaction\n            Else\n              Select (review) a product\n              None\n              Save (like)\n             Add Cart (Card)\n               \"n_items\"+1\n            If \"n_items\" = 0\n              None\n            Else\n              None\n              Remove item(s) of Cart (Card)\n              Order\n                Add Payment Method\n                  Digital Wallets (E-wallets)\n                  Credit & Debit Cards\n                  Buy Now, Pay Later (BNPL)\n                  Bank Transfers / ACH\n                  Cryptocurrency\n                  Cash on Delivery (COD)\n                Add address\n                  Confirm payment                                 \n                Send an email that confirm payment\n                   Status\n                     Pending\n                     Confirmed\n                     Shipped\n                     Delivered",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Click on search bar\n      Typing \"n\" characters\n        Show a list of \"n\" previewed results\n        If n = 0\n          End interaction\n        Else\n          Click on any Item showed in a list with preview \"n\" results\n          Click on Search Icon\n        Apply filters\n          None\n          Sort by \n            Price Low to High\n            Price High or Low\n          Price range\n            Based on list of results. Get MAX and MIN and split in 5 slots\n              S/. 0 - S/. 20\n              S/. 21 - S/. 30\n              ...\n          Brands\n            Based on list of results group by categories\n              None\n              Nike\n              Adidas\n\n        Click on \"Apply Filters\" button\n          Show a list of \"n\" results\n            If n = 0\n              End interaction\n            Else\n              Select (review) a product\n              None\n              Save (like)\n             Add Cart (Card)\n               \"n_items\"+1\n            If \"n_items\" = 0\n              None\n            Else\n              None\n              Remove item(s) of Cart (Card)\n              Order\n                Add Payment Method\n                  Digital Wallets (E-wallets)\n                  Credit & Debit Cards\n                  Buy Now, Pay Later (BNPL)\n                  Bank Transfers / ACH\n                  Cryptocurrency\n                  Cash on Delivery (COD)\n                Add address\n                  Confirm payment                                 \n                Send an email that confirm payment\n                   Status\n                     Pending\n                     Confirmed\n                     Shipped\n                     Delivered",
      "autoResize": true,
      "lineHeight": 1.25
    },
